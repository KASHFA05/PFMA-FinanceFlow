@model List<PFMA.Models.Debt>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Debt Tracker";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="cf-head">
    <div>
        <h2 class="cf-title"><i class="fa-solid fa-money-bill-transfer"></i> Debt &amp; Loan Tracker</h2>
        <div class="cf-sub">Manage and track your borrowed money, loans given, and repayments.</div>
    </div>
    <button type="button" class="cf-add-btn" data-open="debt-add-modal"><i class="fa-solid fa-plus"></i> Add New Debt</button>
</div>

<div class="cf-stats">
    <div class="cf-stat red"><div class="label">I still have to pay</div><div class="value" style="color:#dc2626;">@CurrencyHelper.Symbol(Context) @String.Format("{0:N0}", ViewBag.TotalToPay)</div></div>
    <div class="cf-stat blue"><div class="label">Still to receive</div><div class="value" style="color:#2563eb;">@CurrencyHelper.Symbol(Context) @String.Format("{0:N0}", ViewBag.TotalToReceive)</div></div>
</div>

@if (Model.Count == 0)
{
    <div class="cf-empty">No debts or loans yet. Click "Add New Debt" to record one.</div>
}
else
{
    <div class="cf-grid" style="grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));">
        @foreach (var d in Model)
        {
            bool pay = d.Type == "To Pay";
            double pct = d.TotalAmount > 0 ? (double)(d.ClearedAmount / d.TotalAmount) * 100 : 0;
            double barPct = Math.Min(100, Math.Max(0, pct));
            string accent = d.IsCleared ? "c-teal" : (pay ? "c-red" : "c-blue");
            string barClass = d.IsCleared ? "" : (pay ? "red" : "blue");
            string amountColor = d.IsCleared ? "#0d9488" : (pay ? "#dc2626" : "#2563eb");
            <div class="cf-card @accent">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem;">
                    <h3 class="cf-card-title"><i class="fa-regular @(pay ? "fa-circle-down" : "fa-circle-up")" style="color:@amountColor; margin-right:0.35rem;"></i>@d.Title</h3>
                    @if (d.IsCleared)
                    {
                        <span class="cf-badge cleared">Cleared</span>
                    }
                    else
                    {
                        <span class="cf-badge @(pay ? "topay" : "toreceive")">@d.Type</span>
                    }
                </div>
                <div class="cf-meta"><i class="fa-regular fa-calendar"></i> Due Date: <strong>@d.DueDate.ToString("dd MMM yyyy")</strong></div>
                <div class="cf-row">
                    <span>Cleared: @CurrencyHelper.Symbol(Context) @String.Format("{0:N0}", d.ClearedAmount)</span>
                    <span>Total: @CurrencyHelper.Symbol(Context) @String.Format("{0:N0}", d.TotalAmount)</span>
                </div>
                <div class="cf-progress @barClass"><div style="width: @(barPct.ToString("0.##", inv))%;"></div></div>
                <div class="cf-percent">@pct.ToString("0.0", inv)% Completed</div>
                <div class="cf-amount-big" style="color:@amountColor;">Remaining: @CurrencyHelper.Symbol(Context) @String.Format("{0:N0}", d.Remaining)</div>
                <div class="cf-actions">
                    <button type="button" class="cf-btn" data-open="debt-edit-modal"
                            data-fill-id="@d.DebtId" data-fill-title="@d.Title" data-fill-type="@d.Type"
                            data-fill-totalamount="@d.TotalAmount.ToString("0.##", inv)" data-fill-clearedamount="@d.ClearedAmount.ToString("0.##", inv)"
                            data-fill-duedate="@d.DueDate.ToString("yyyy-MM-dd")">
                        <i class="fa-regular fa-pen-to-square"></i> Update
                    </button>
                    <form action="@Url.Action("Delete", "Debts")" method="post" onsubmit="return confirm('Delete this entry?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@d.DebtId" />
                        <button type="submit" class="cf-btn danger"><i class="fa-regular fa-trash-can"></i> Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
}

<div class="modal-overlay" id="debt-add-modal">
    <div class="modal-content">
        <div class="modal-header"><h3 class="card-title">Add New Debt</h3><button type="button" class="modal-close" data-close>&times;</button></div>
        <form action="@Url.Action("Add", "Debts")" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group"><label>Title</label><input type="text" name="title" class="form-control" placeholder="e.g. Borrowed from Ali" required /></div>
            <div class="form-group"><label>Type</label>
                <select name="type" class="form-control"><option value="To Pay">To Pay (I owe)</option><option value="To Receive">To Receive (they owe me)</option></select></div>
            <div class="form-group"><label>Total Amount (@CurrencyHelper.Symbol(Context))</label><input type="number" step="0.01" min="1" name="totalAmount" class="form-control" required /></div>
            <div class="form-group"><label>Already Cleared (@CurrencyHelper.Symbol(Context))</label><input type="number" step="0.01" min="0" name="clearedAmount" class="form-control" value="0" /></div>
            <div class="form-group"><label>Due Date</label><input type="date" name="dueDate" class="form-control" value="@DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd")" required /></div>
            <div class="modal-btn-row"><button type="button" class="btn-secondary" data-close>Cancel</button><button type="submit" class="btn-primary">Save</button></div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="debt-edit-modal">
    <div class="modal-content">
        <div class="modal-header"><h3 class="card-title">Update Debt</h3><button type="button" class="modal-close" data-close>&times;</button></div>
        <form action="@Url.Action("Update", "Debts")" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" data-field="id" />
            <div class="form-group"><label>Title</label><input type="text" name="title" data-field="title" class="form-control" required /></div>
            <div class="form-group"><label>Type</label>
                <select name="type" data-field="type" class="form-control"><option value="To Pay">To Pay (I owe)</option><option value="To Receive">To Receive (they owe me)</option></select></div>
            <div class="form-group"><label>Total Amount (@CurrencyHelper.Symbol(Context))</label><input type="number" step="0.01" min="1" name="totalAmount" data-field="totalamount" class="form-control" required /></div>
            <div class="form-group"><label>Cleared Amount (@CurrencyHelper.Symbol(Context))</label><input type="number" step="0.01" min="0" name="clearedAmount" data-field="clearedamount" class="form-control" required /></div>
            <div class="form-group"><label>Due Date</label><input type="date" name="dueDate" data-field="duedate" class="form-control" required /></div>
            <div class="modal-btn-row"><button type="button" class="btn-secondary" data-close>Cancel</button><button type="submit" class="btn-primary">Update</button></div>
        </form>
    </div>
</div>
