@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome - FinanceFlow (blue v3)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { min-height: 100%; }
        body {
            font-family: 'Inter', 'Segoe UI', Arial, sans-serif; color: #fff; overflow-x: hidden;
            background: radial-gradient(circle at 20% 15%, #1e1b4b 0%, #0b1020 55%, #02040a 100%);
            background-attachment: fixed;
        }
        a { text-decoration: none; color: inherit; }

        /* ---------- background effects ---------- */
        .glow { position: fixed; border-radius: 50%; filter: blur(90px); pointer-events: none; animation: drift 12s ease-in-out infinite; }
        .glow.g1 { width: 420px; height: 420px; background: rgba(79,70,229,.55); top: -120px; left: -100px; }
        .glow.g2 { width: 360px; height: 360px; background: rgba(14,165,233,.5); bottom: -120px; right: -80px; animation-delay: -5s; }
        @@keyframes drift { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(40px, -30px) scale(1.12); } }
        .grid-bg { position: fixed; inset: 0; opacity: .22; pointer-events: none;
            background-image: linear-gradient(rgba(129,140,248,.25) 1px, transparent 1px), linear-gradient(90deg, rgba(129,140,248,.25) 1px, transparent 1px);
            background-size: 46px 46px;
            -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 20%, transparent 75%); mask-image: radial-gradient(circle at 50% 50%, #000 20%, transparent 75%);
            animation: gridMove 18s linear infinite; }
        @@keyframes gridMove { to { background-position: 46px 46px, 46px 46px; } }
        .dot { position: fixed; width: 5px; height: 5px; border-radius: 50%; background: #bfdbfe; box-shadow: 0 0 10px 2px rgba(191,219,254,.8); animation: twinkle 3s ease-in-out infinite; pointer-events: none; }
        @@keyframes twinkle { 0%, 100% { opacity: .1; transform: scale(.6); } 50% { opacity: .9; transform: scale(1.3); } }

        .page { position: relative; z-index: 2; max-width: 1240px; margin: 0 auto; padding: 1.4rem 2rem 2rem; min-height: 100vh; display: flex; flex-direction: column; }

        /* ---------- navbar ---------- */
        .nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; animation: dropIn .8s ease both; }
        .brand { display: flex; align-items: center; gap: .6rem; font-weight: 800; font-size: 1.15rem; }
        .brand i { width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, #6366f1, #0ea5e9); color: #fff; display: inline-flex; align-items: center; justify-content: center; animation: spinIn 1.2s ease both; }
        @@keyframes spinIn { from { transform: rotate(-200deg) scale(0); } to { transform: rotate(0) scale(1); } }
        .links { display: flex; gap: 2rem; font-size: .88rem; font-weight: 500; color: #dbeafe; }
        .links span { cursor: default; position: relative; padding: .3rem 0; }
        .links span::after { content: ''; position: absolute; left: 0; bottom: 0; height: 2px; width: 0; background: #93c5fd; transition: width .3s ease; }
        .links span:hover::after { width: 100%; }
        .nav-actions { display: flex; gap: .7rem; }
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; padding: .65rem 1.3rem; border-radius: 99px; font-weight: 700; font-size: .88rem; transition: transform .2s ease, box-shadow .2s ease, background .2s ease; white-space: nowrap; }
        .btn:hover { transform: translateY(-3px); }
        .btn-line { border: 1.5px solid rgba(255,255,255,.7); color: #fff; }
        .btn-line:hover { background: rgba(255,255,255,.12); }
        .btn-lime { background: linear-gradient(90deg, #2563eb, #4f46e5); color: #fff; box-shadow: 0 8px 22px rgba(37,99,235,.45); }
        .btn-lime:hover { filter: brightness(1.15); }
        .btn-white { background: #fff; color: #1e1b4b; }
        .btn-lg { padding: .9rem 1.8rem; font-size: .95rem; }
        .pulse { animation: pulseGlow 2.2s ease-in-out infinite; }
        @@keyframes pulseGlow { 0%, 100% { box-shadow: 0 8px 22px rgba(37,99,235,.45), 0 0 0 0 rgba(59,130,246,.65); } 50% { box-shadow: 0 8px 22px rgba(37,99,235,.45), 0 0 0 16px rgba(59,130,246,0); } }
        @@keyframes dropIn { from { opacity: 0; transform: translateY(-24px); } to { opacity: 1; transform: translateY(0); } }

        /* ---------- hero ---------- */
        .hero { flex: 1; display: grid; grid-template-columns: 1fr 1.05fr; gap: 2.5rem; align-items: center; padding: 2.5rem 0 1.5rem; }
        .badge { display: inline-flex; align-items: center; gap: .55rem; padding: .4rem .9rem; border-radius: 99px; background: rgba(0,0,0,.28); border: 1px solid rgba(255,255,255,.18); font-size: .75rem; font-weight: 600; color: #bfdbfe; animation: fadeUp .8s .2s ease both; }
        .badge b { width: 8px; height: 8px; border-radius: 50%; background: #3b82f6; box-shadow: 0 0 0 0 rgba(59,130,246,.8); animation: ping 1.8s infinite; }
        @@keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(59,130,246,.8); } 100% { box-shadow: 0 0 0 10px rgba(59,130,246,0); } }

        h1 { font-size: 3.4rem; line-height: 1.08; font-weight: 800; letter-spacing: -1.5px; margin: 1.1rem 0 1.1rem; }
        h1 .w { display: inline-block; opacity: 0; transform: translateY(34px) rotate(3deg); animation: wordIn .8s cubic-bezier(.2,.9,.3,1) forwards; }
        h1 .hl { background: linear-gradient(90deg, #a5b4fc, #67e8f9, #f9a8d4, #a5b4fc); background-size: 250% auto; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: wordIn .8s cubic-bezier(.2,.9,.3,1) forwards, shimmer 4s linear infinite; }
        @@keyframes wordIn { to { opacity: 1; transform: translateY(0) rotate(0); } }
        @@keyframes shimmer { to { background-position: 250% center; } }
        .lead { color: #dbeafe; font-size: 1rem; line-height: 1.7; max-width: 470px; opacity: .92; animation: fadeUp .9s 1.2s ease both; }
        .cta { display: flex; gap: .9rem; flex-wrap: wrap; margin-top: 1.8rem; animation: fadeUp .9s 1.45s ease both; }
        @@keyframes fadeUp { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: translateY(0); } }

        /* ---------- mockups ---------- */
        .mock { position: relative; height: 470px; animation: slideLeft 1.1s .5s cubic-bezier(.2,.9,.3,1) both; }
        @@keyframes slideLeft { from { opacity: 0; transform: translateX(90px); } to { opacity: 1; transform: translateX(0); } }
        .dash { position: absolute; left: 0; top: 20px; width: 78%; background: #fff; color: #0f172a; border-radius: 14px; box-shadow: 0 30px 70px rgba(0,0,0,.45); display: flex; overflow: hidden; }
        .dash-side { width: 54px; background: #f1f5f9; padding: 1rem 0; display: flex; flex-direction: column; align-items: center; gap: 1.1rem; color: #94a3b8; font-size: .8rem; }
        .dash-side .on { color: #2563eb; background: #dbeafe; width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; }
        .dash-main { flex: 1; padding: 1rem 1.1rem; min-width: 0; }
        .dash-title { display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: .85rem; }
        .dash-title small { color: #94a3b8; font-weight: 500; font-size: .65rem; }
        .bal-label { font-size: .65rem; color: #64748b; margin-top: .8rem; }
        .bal { font-size: 1.55rem; font-weight: 800; letter-spacing: -.5px; }
        .bal small { font-size: .7rem; color: #2563eb; font-weight: 700; margin-left: .4rem; }
        .chart { width: 100%; height: 120px; margin-top: .3rem; }
        .chart .line { fill: none; stroke: #2563eb; stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 2.4s 1.2s ease forwards; }
        .chart .area { fill: url(#areaGrad); opacity: 0; animation: fadeIn 1.2s 2.4s ease forwards; }
        @@keyframes draw { to { stroke-dashoffset: 0; } }
        @@keyframes fadeIn { to { opacity: 1; } }
        .rows { margin-top: .5rem; }
        .row { display: flex; align-items: center; justify-content: space-between; font-size: .7rem; padding: .45rem 0; border-top: 1px solid #f1f5f9; opacity: 0; transform: translateX(26px); animation: rowIn .7s ease forwards; }
        .row:nth-child(1) { animation-delay: 2.0s; } .row:nth-child(2) { animation-delay: 2.25s; } .row:nth-child(3) { animation-delay: 2.5s; }
        @@keyframes rowIn { to { opacity: 1; transform: translateX(0); } }
        .row .l { display: flex; align-items: center; gap: .55rem; font-weight: 600; }
        .row .l i { width: 24px; height: 24px; border-radius: 7px; display: inline-flex; align-items: center; justify-content: center; font-size: .65rem; }
        .row .plus { color: #16a34a; font-weight: 700; } .row .minus { color: #e11d48; font-weight: 700; }

        .phone { position: absolute; right: 2%; bottom: 0; width: 170px; height: 330px; border-radius: 30px; background: #0b1330; padding: 8px; box-shadow: 0 30px 70px rgba(0,0,0,.55); transform: rotate(8deg); animation: phoneFloat 5s ease-in-out infinite, phoneIn 1.1s .9s cubic-bezier(.2,.9,.3,1) backwards; }
        @@keyframes phoneFloat { 0%, 100% { transform: rotate(8deg) translateY(0); } 50% { transform: rotate(6deg) translateY(-16px); } }
        @@keyframes phoneIn { from { opacity: 0; margin-bottom: -120px; } to { opacity: 1; margin-bottom: 0; } }
        .screen { width: 100%; height: 100%; background: #fff; color: #0f172a; border-radius: 23px; padding: .9rem .75rem; overflow: hidden; position: relative; }
        .screen::before { content: ''; position: absolute; top: 6px; left: 50%; transform: translateX(-50%); width: 46px; height: 12px; border-radius: 99px; background: #0b1330; }
        .screen .hello { margin-top: 1.1rem; font-size: .62rem; color: #64748b; }
        .screen .name { font-size: .78rem; font-weight: 800; }
        .card-green { margin-top: .6rem; background: linear-gradient(135deg, #4f46e5, #2563eb); color: #fff; border-radius: 12px; padding: .7rem; }
        .card-green small { font-size: .55rem; opacity: .85; }
        .card-green .v { font-size: 1.05rem; font-weight: 800; }
        .mini { width: 100%; height: 44px; margin-top: .3rem; }
        .mini path { fill: none; stroke: #bfdbfe; stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 2s 2s ease forwards; }
        .goal { margin-top: .7rem; font-size: .6rem; font-weight: 700; }
        .goal .bar { height: 6px; background: #e2e8f0; border-radius: 99px; overflow: hidden; margin-top: .25rem; }
        .goal .bar div { height: 100%; width: 0; border-radius: 99px; background: linear-gradient(90deg, #3b82f6, #22d3ee); animation: grow 1.6s 2.3s ease forwards; }
        @@keyframes grow { to { width: var(--w); } }

        .chip { position: absolute; background: #fff; color: #0f172a; border-radius: 12px; padding: .55rem .8rem; font-size: .72rem; font-weight: 700; display: flex; align-items: center; gap: .5rem; box-shadow: 0 16px 40px rgba(0,0,0,.35); animation: chipPop 6s ease-in-out infinite; opacity: 0; }
        .chip i { width: 26px; height: 26px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; background: #dbeafe; color: #2563eb; }
        .chip.c1 { top: 0; right: 12%; animation-delay: 2.6s; }
        .chip.c2 { bottom: 70px; left: -4%; animation-delay: 4.4s; }
        .chip.c2 i { background: #fef3c7; color: #d97706; }
        @@keyframes chipPop { 0% { opacity: 0; transform: translateY(20px) scale(.8); } 10%, 45% { opacity: 1; transform: translateY(0) scale(1); } 60%, 100% { opacity: 0; transform: translateY(-14px) scale(.9); } }

        /* ---------- bottom row ---------- */
        .trusted { display: flex; align-items: center; gap: 2.5rem; flex-wrap: wrap; padding-top: 1.4rem; border-top: 1px solid rgba(255,255,255,.12); animation: fadeUp .9s 1.9s ease both; }
        .trusted p { font-size: .72rem; color: #bfdbfe; font-weight: 600; max-width: 150px; line-height: 1.4; }
        .logos { display: flex; gap: 2rem; flex-wrap: wrap; align-items: center; }
        .logos span { display: inline-flex; align-items: center; gap: .55rem; font-weight: 700; font-size: .95rem; color: #eff6ff; opacity: .85; transition: transform .25s ease, opacity .25s ease; }
        .logos span:hover { transform: translateY(-4px); opacity: 1; }
        .logos i { color: #7dd3fc; }

        @@media (max-width: 1000px) {
            .hero { grid-template-columns: 1fr; }
            .links { display: none; }
            h1 { font-size: 2.6rem; }
            .mock { height: 440px; }
            .dash { width: 92%; }
        }
        @@media (max-width: 560px) {
            .phone, .chip { display: none; }
            .nav-actions .btn-line { display: none; }
            h1 { font-size: 2.2rem; }
            .mock { height: 360px; }
            .dash { width: 100%; }
        }
    </style>
</head>
<body>
    <div class="grid-bg"></div>
    <div class="glow g1"></div>
    <div class="glow g2"></div>
    <span class="dot" style="left:6%; top:18%; animation-delay:0s"></span>
    <span class="dot" style="left:18%; top:78%; animation-delay:.8s"></span>
    <span class="dot" style="left:33%; top:9%; animation-delay:1.5s"></span>
    <span class="dot" style="left:47%; top:88%; animation-delay:.4s"></span>
    <span class="dot" style="left:58%; top:14%; animation-delay:2s"></span>
    <span class="dot" style="left:71%; top:70%; animation-delay:1.1s"></span>
    <span class="dot" style="left:86%; top:20%; animation-delay:.6s"></span>
    <span class="dot" style="left:94%; top:55%; animation-delay:1.8s"></span>

    <div class="page">

        <!-- navbar -->
        <div class="nav">
            <div class="brand"><i class="fa-solid fa-building-columns"></i> FinanceFlow</div>
            <div class="links">
                <span>Features</span><span>Budgets</span><span>Goals</span><span>Reports</span><span>Security</span>
            </div>
            <div class="nav-actions">
                <a class="btn btn-line" href="@Url.Action("Login", "Account")">Sign In</a>
                <a class="btn btn-lime" href="@Url.Action("Register", "Account")">Open an Account</a>
            </div>
        </div>

        <!-- hero -->
        <div class="hero">
            <div>
                <span class="badge"><b></b> New: Budgets, Debt Tracker &amp; PDF Reports</span>
                <h1>
                    <span class="w" style="animation-delay:.4s">All&#8209;In&#8209;One</span>
                    <span class="w hl" style="animation-delay:.55s">Finance</span>
                    <span class="w" style="animation-delay:.7s">App</span>
                    <span class="w" style="animation-delay:.85s">for</span>
                    <span class="w" style="animation-delay:1s">Your</span>
                    <span class="w hl" style="animation-delay:1.1s">Money</span>
                </h1>
                <p class="lead">Keep your income, expenses, savings goals, bills and debts safely organized under one roof. Manage money quickly, easily and efficiently, whether you are a student or running a family budget.</p>
                <div class="cta">
                    <a class="btn btn-lime btn-lg pulse" href="@Url.Action("Register", "Account")">Open an Account <i class="fa-solid fa-arrow-right"></i></a>
                    <a class="btn btn-white btn-lg" href="@Url.Action("Login", "Account")">Sign In</a>
                </div>
            </div>

            <div class="mock">
                <div class="dash">
                    <div class="dash-side">
                        <span class="on"><i class="fa-solid fa-house"></i></span>
                        <i class="fa-solid fa-list-check"></i>
                        <i class="fa-solid fa-piggy-bank"></i>
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                        <i class="fa-solid fa-chart-pie"></i>
                    </div>
                    <div class="dash-main">
                        <div class="dash-title">Dashboard <small>Last 6 months</small></div>
                        <div class="bal-label">Total Balance</div>
                        <div class="bal">Rs. <span id="counter">0</span><small><i class="fa-solid fa-arrow-trend-up"></i> +12.4%</small></div>
                        <svg class="chart" viewBox="0 0 300 120" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#2563eb" stop-opacity=".35" />
                                    <stop offset="100%" stop-color="#2563eb" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <path class="area" d="M0,95 C30,85 50,98 80,74 S130,64 160,54 S210,60 240,34 S280,28 300,16 L300,120 L0,120 Z" />
                            <path class="line" pathLength="1" d="M0,95 C30,85 50,98 80,74 S130,64 160,54 S210,60 240,34 S280,28 300,16" />
                        </svg>
                        <div class="rows">
                            <div class="row"><span class="l"><i class="fa-solid fa-briefcase" style="background:#dcfce7;color:#16a34a;"></i> Monthly Salary</span><span class="plus">+ Rs. 200,000</span></div>
                            <div class="row"><span class="l"><i class="fa-solid fa-house" style="background:#fee2e2;color:#e11d48;"></i> Rent</span><span class="minus">- Rs. 5,000</span></div>
                            <div class="row"><span class="l"><i class="fa-solid fa-cart-shopping" style="background:#fef3c7;color:#d97706;"></i> Shopping</span><span class="minus">- Rs. 3,000</span></div>
                        </div>
                    </div>
                </div>

                <div class="phone">
                    <div class="screen">
                        <div class="hello">Welcome back,</div>
                        <div class="name">FinanceFlow User</div>
                        <div class="card-green">
                            <small>Available Balance</small>
                            <div class="v">Rs. 214,500</div>
                            <svg class="mini" viewBox="0 0 120 44" preserveAspectRatio="none"><path pathLength="1" d="M0,34 C14,30 22,36 38,24 S62,22 76,16 S102,18 120,6" /></svg>
                        </div>
                        <div class="goal">New Laptop<div class="bar"><div style="--w:62%"></div></div></div>
                        <div class="goal">Emergency Fund<div class="bar"><div style="--w:80%"></div></div></div>
                        <div class="goal">Car<div class="bar"><div style="--w:45%"></div></div></div>
                    </div>
                </div>

                <div class="chip c1"><i class="fa-solid fa-circle-check"></i> Electricity bill paid</div>
                <div class="chip c2"><i class="fa-solid fa-bell"></i> Internet due in 2 days</div>
            </div>
        </div>

        <!-- bottom row -->
        <div class="trusted">
            <p>Everything you need in one place</p>
            <div class="logos">
                <span><i class="fa-solid fa-list-check"></i> Transactions</span>
                <span><i class="fa-solid fa-wallet"></i> Budgets</span>
                <span><i class="fa-solid fa-piggy-bank"></i> Savings</span>
                <span><i class="fa-solid fa-qrcode"></i> Bill QR</span>
                <span><i class="fa-solid fa-file-pdf"></i> Reports</span>
            </div>
        </div>
    </div>

    <script>
        // balance counter
        (function () {
            var el = document.getElementById('counter');
            var target = 214500, duration = 2200, start = null;
            function step(ts) {
                if (!start) start = ts + 900;           // wait for the dashboard to slide in
                var p = Math.min(Math.max((ts - start) / duration, 0), 1);
                var eased = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(target * eased).toLocaleString('en-US');
                if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        })();
    </script>
</body>
</html>
