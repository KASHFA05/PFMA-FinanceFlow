@model List<PFMA.Models.Budget>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Budgets";
    string month = ViewBag.Month as string ?? DateTime.Now.ToString("yyyy-MM");
    var spent = ViewBag.Spent as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
    decimal totalBudget = ViewBag.TotalBudget;
    decimal totalSpent = ViewBag.TotalSpent;
    decimal remaining = totalBudget - totalSpent;
    var categories = new[] { "Food", "Transport", "Bills", "Housing", "Shopping", "Entertainment", "Health", "Misc" };
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h2 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 0.25rem;">Budgets</h2>
        <span style="font-size: 0.85rem; color: var(--text-secondary);">Set monthly limits per category and track how much you have spent.</span>
    </div>
    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
        <form method="get" action="@Url.Action("Index", "Budgets")">
            <input type="month" name="month" value="@month" class="form-control" onchange="this.form.submit()" style="width:auto;" />
        </form>
        <button class="btn-primary" id="open-budget-modal-btn" style="width: auto; padding: 0.75rem 1.5rem; display: flex; align-items: center; gap: 0.5rem; border-radius: 12px; font-weight: 600;">
            <i class="fa-solid fa-plus"></i> Set Budget
        </button>
    </div>
</div>

<div class="dashboard-grid" style="margin-bottom: 2rem;">
    <div class="stat-card">
        <div class="stat-details">
            <span class="stat-label">Total Budget</span>
            <span class="stat-value">@CurrencyHelper.Symbol(Context) @String.Format("{0:N2}", totalBudget)</span>
        </div>
        <div class="stat-icon icon-blue"><i class="fa-solid fa-wallet"></i></div>
    </div>
    <div class="stat-card">
        <div class="stat-details">
            <span class="stat-label">Spent</span>
            <span class="stat-value" style="color: var(--danger);">@CurrencyHelper.Symbol(Context) @String.Format("{0:N2}", totalSpent)</span>
        </div>
        <div class="stat-icon icon-red"><i class="fa-solid fa-arrow-trend-down"></i></div>
    </div>
    <div class="stat-card">
        <div class="stat-details">
            <span class="stat-label">Remaining</span>
            <span class="stat-value" style="color: @(remaining < 0 ? "var(--danger)" : "var(--success)");">@CurrencyHelper.Symbol(Context) @String.Format("{0:N2}", remaining)</span>
        </div>
        <div class="stat-icon icon-green"><i class="fa-solid fa-piggy-bank"></i></div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr; gap: 1.25rem; margin-bottom: 3rem;">
    @if (Model.Count == 0)
    {
        <div class="content-card" style="text-align: center; color: var(--text-light); padding: 3rem;">No budgets set for this month. Click Set Budget to create one!</div>
    }
    else
    {
        foreach (var b in Model)
        {
            decimal used = spent.ContainsKey(b.Category) ? spent[b.Category] : 0m;
            double pct = b.Amount > 0 ? (double)(used / b.Amount) * 100 : 0;
            double barPct = Math.Min(100, Math.Max(0, pct));
            string barColor = pct >= 100 ? "#dc2626" : (pct >= 80 ? "#f59e0b" : "#0f766e");

            <div class="content-card" style="padding: 1.25rem 1.5rem; border-radius: 18px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <span style="font-weight: 700; font-size: 1.05rem;">@b.Category</span>
                    <form action="@Url.Action("Delete", "Budgets")" method="post" style="display:inline;" onsubmit="return confirm('Delete this budget?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@b.BudgetId" />
                        <input type="hidden" name="month" value="@month" />
                        <button type="submit" class="bill-btn btn-delete" title="Delete"><i class="fa-regular fa-trash-can" style="color: var(--text-light);"></i></button>
                    </form>
                </div>
                <div style="display: flex; justify-content: space-between; font-weight: 600; font-size: 0.9rem; margin-bottom: 0.5rem;">
                    <span>@CurrencyHelper.Symbol(Context) @String.Format("{0:N2}", used) <span style="font-weight: 400; color: var(--text-light);">/ @CurrencyHelper.Symbol(Context) @String.Format("{0:N2}", b.Amount)</span></span>
                    <span style="color: @barColor;">@Math.Round(pct, 0)%</span>
                </div>
                <div class="progress-container" style="height: 8px; background-color: #f1f3f7; border-radius: 4px; overflow: hidden; margin-top: 0;">
                    <div class="progress-bar" style="width: @(barPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; height: 100%; background-color: @barColor; border-radius: 4px;"></div>
                </div>
                @if (pct >= 100)
                {
                    <div style="margin-top: 0.5rem; font-size: 0.8rem; color: var(--danger);"><i class="fa-solid fa-triangle-exclamation"></i> Budget exceeded</div>
                }
            </div>
        }
    }
</div>

<div class="modal-overlay" id="add-budget-modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="card-title">Set Budget</h3>
            <button class="modal-close" id="budget-modal-close-btn">&times;</button>
        </div>
        <form action="@Url.Action("Add", "Budgets")" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Category</label>
                <select name="category" class="form-control" required>
                    <option value="">Select Category</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Monthly Limit</label>
                <input type="number" step="0.01" min="1" name="amount" class="form-control" placeholder="0.00" required />
            </div>
            <div class="form-group">
                <label>Month</label>
                <input type="month" name="month" class="form-control" value="@month" required />
            </div>
            <div class="modal-btn-row">
                <button type="button" class="btn-secondary" id="budget-modal-cancel-btn">Cancel</button>
                <button type="submit" class="btn-primary">Save Budget</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = document.getElementById("add-budget-modal");
            const open = document.getElementById("open-budget-modal-btn");
            const hide = () => modal.classList.remove("active");
            if (open) open.addEventListener("click", () => modal.classList.add("active"));
            document.getElementById("budget-modal-close-btn").addEventListener("click", hide);
            document.getElementById("budget-modal-cancel-btn").addEventListener("click", hide);
        });
    </script>
}
