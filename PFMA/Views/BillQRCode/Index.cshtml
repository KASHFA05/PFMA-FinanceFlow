@model List<PFMA.Models.BillQRCode>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Bill QR Codes";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h2 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 0.25rem;">Bill QR Codes</h2>
        <span style="font-size: 0.85rem; color: var(--text-secondary);">Generate a QR code for each bill's consumer number and amount.</span>
    </div>
    <button class="btn-primary" id="open-qr-modal-btn" style="width: auto; padding: 0.75rem 1.5rem; display: flex; align-items: center; gap: 0.5rem; border-radius: 12px; font-weight: 600;">
        <i class="fa-solid fa-qrcode"></i> New QR Code
    </button>
</div>

@if (Model.Count == 0)
{
    <div class="content-card" style="text-align: center; color: var(--text-light); padding: 3rem;">No QR codes yet. Click New QR Code to create one!</div>
}
else
{
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
        @foreach (var q in Model)
        {
            <div class="content-card" style="padding: 1.5rem; border-radius: 18px; text-align: center;">
                <img src="@Url.Action("GenerateQRCode", "BillQRCode", new { id = q.QRCodeId })" alt="QR for @q.Title" style="width: 180px; height: 180px; image-rendering: pixelated;" />
                <div style="font-weight: 700; margin-top: 1rem;">@q.Title</div>
                <div style="font-size: 0.8rem; color: var(--text-secondary);">Consumer No: @q.ConsumerNumber</div>
                <div style="font-weight: 700; font-size: 1.1rem; margin: 0.5rem 0 1rem;">@CurrencyHelper.Symbol(Context) @String.Format("{0:N2}", q.Amount)</div>
                <form action="@Url.Action("Delete", "BillQRCode")" method="post" onsubmit="return confirm('Delete this QR code?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@q.QRCodeId" />
                    <button type="submit" class="btn-secondary" style="width: auto; padding: 0.4rem 1rem; font-size: 0.8rem;"><i class="fa-regular fa-trash-can"></i> Delete</button>
                </form>
            </div>
        }
    </div>
}

<div class="modal-overlay" id="add-qr-modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="card-title">New Bill QR Code</h3>
            <button class="modal-close" id="qr-modal-close-btn">&times;</button>
        </div>
        <form action="@Url.Action("Add", "BillQRCode")" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Bill Title</label>
                <input type="text" name="Title" class="form-control" placeholder="e.g. WAPDA Bill, PTCL" required />
            </div>
            <div class="form-group">
                <label>Consumer Number / Reference</label>
                <input type="text" name="ConsumerNumber" class="form-control" placeholder="e.g. 0412345678901" required />
            </div>
            <div class="form-group">
                <label>Amount</label>
                <input type="number" step="0.01" min="0" name="Amount" class="form-control" placeholder="0.00" required />
            </div>
            <div class="modal-btn-row">
                <button type="button" class="btn-secondary" id="qr-modal-cancel-btn">Cancel</button>
                <button type="submit" class="btn-primary">Generate</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = document.getElementById("add-qr-modal");
            const open = document.getElementById("open-qr-modal-btn");
            const hide = () => modal.classList.remove("active");
            if (open) open.addEventListener("click", () => modal.classList.add("active"));
            document.getElementById("qr-modal-close-btn").addEventListener("click", hide);
            document.getElementById("qr-modal-cancel-btn").addEventListener("click", hide);
        });
    </script>
}
