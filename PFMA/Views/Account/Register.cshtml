    <script>
        // show / hide password (works for both password fields)
        document.querySelectorAll('.lg-eye').forEach(function (eye) {
            eye.addEventListener('click', function () {
                var input = document.getElementById(eye.getAttribute('data-target'));
                if (!input) return;
                var hidden = input.type === 'password';
                input.type = hidden ? 'text' : 'password';
                eye.classList.toggle('fa-eye', !hidden);
                eye.classList.toggle('fa-eye-slash', hidden);
            });
        });

        // password strength + match check
        (function () {
            var pwd = document.getElementById('password');
            var confirmInput = document.getElementById('confirmPassword');
            var bar = document.getElementById('strengthBar');
            var text = document.getElementById('strengthText');
            var match = document.getElementById('matchText');

            function strength(v) {
                var score = 0;
                if (v.length >= 8) score++;
                if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
                if (/[0-9]/.test(v)) score++;
                if (/[^A-Za-z0-9]/.test(v)) score++;
                return score;
            }

            function updateStrength() {
                var v = pwd.value;
                if (!v) {
                    bar.style.width = '0'; text.textContent = 'Use 8+ characters with letters, numbers and a symbol'; text.className = 'lg-hint';
                    return;
                }
                var s = strength(v);
                var labels = ['Very weak', 'Weak', 'Okay', 'Strong', 'Very strong'];
                var colors = ['#e11d48', '#f97316', '#f59e0b', '#22c55e', '#16a34a'];
                bar.style.width = (20 + s * 20) + '%';
                bar.style.background = colors[s];
                text.textContent = 'Password strength: ' + labels[s];
                text.className = 'lg-hint' + (s >= 3 ? ' ok' : '');
            }

            function updateMatch() {
                if (!confirmInput.value) { match.textContent = ''; match.className = 'lg-hint'; confirmInput.setCustomValidity(''); return; }
                if (confirmInput.value === pwd.value) {
                    match.innerHTML = '<i class="fa-solid fa-circle-check"></i> Passwords match'; match.className = 'lg-hint ok'; confirmInput.setCustomValidity('');
                } else {
                    match.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> Passwords do not match'; match.className = 'lg-hint bad'; confirmInput.setCustomValidity('Passwords do not match');
                }
            }

            pwd.addEventListener('input', function () { updateStrength(); updateMatch(); });
            confirmInput.addEventListener('input', updateMatch);
        })();

        // rotating showcase cards (the middle card glows and animates)
        (function () {
            var cards = Array.prototype.slice.call(document.querySelectorAll('.lg-card'));
            var dots = Array.prototype.slice.call(document.querySelectorAll('#dots span'));
            if (!cards.length) return;
            var active = 0;
            var gap = 300;
            var stage = document.getElementById('stage');

            // shrink the showcase so that all three cards fit inside the left panel
            function fit() {
                var w = stage.parentElement.clientWidth;
                var sc = Math.min(1, (w - 30) / 880);
                stage.style.transform = 'scale(' + sc + ')';
                stage.style.transformOrigin = 'center center';
                var m = -(1 - sc) * 200;
                stage.style.marginTop = m + 'px';
                stage.style.marginBottom = m + 'px';
            }
            fit();
            window.addEventListener('resize', fit);

            function layout() {
                var n = cards.length;
                cards.forEach(function (card, i) {
                    var off = (i - active + n) % n;
                    if (off > n / 2) off -= n;
                    var isActive = off === 0;
                    card.classList.toggle('active', isActive);
                    card.style.transform = 'translate(-50%, -50%) translateX(' + (off * gap) + 'px) scale(' + (isActive ? 1 : 0.86) + ')';
                    card.style.opacity = Math.abs(off) > 1 ? 0 : (isActive ? 1 : 0.85);
                    card.style.zIndex = isActive ? 3 : 2;
                });
                dots.forEach(function (d, i) { d.classList.toggle('on', i === active); });
            }

            layout();
            setInterval(function () { active = (active + 1) % cards.length; layout(); }, 1000);
            dots.forEach(function (d, i) { d.style.cursor = 'pointer'; d.addEventListener('click', function () { active = i; layout(); }); });
        })();
    </script>
