@{
    Layout = "_Layout";
    ViewData["Title"] = "Financial Analytics";
}

<!-- Financial Analytics Header Section -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h2 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 0.25rem;">Financial Analytics</h2>
        <span style="font-size: 0.85rem; color: var(--text-secondary);">Detailed breakdown of your spending habits and revenue streams.</span>
    </div>
    <div class="toggle-group">
        <button class="toggle-btn active">Monthly</button>
        <button class="toggle-btn">Yearly</button>
    </div>
</div>

<!-- Download/Export Button Group -->
<div style="display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap;">
    <a href="@Url.Action("ExportPdf", "Home")" id="btn-download-pdf" class="btn-primary" style="background-color: #1e293b; color: white; width: auto; padding: 0.6rem 1.2rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; border-radius: 8px; text-decoration: none;">
        <i class="fa-regular fa-file-pdf"></i> Download PDF
    </a>
    <a href="@Url.Action("ExportExcel", "Home")" id="btn-export-excel" class="btn-primary" style="background-color: #064e3b; color: white; width: auto; padding: 0.6rem 1.2rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; border-radius: 8px; text-decoration: none;">
        <i class="fa-regular fa-file-excel"></i> Export to Excel (CSV)
    </a>
    <a href="@Url.Action("Transactions", "Home")" class="btn-primary" style="background-color: #0f766e; color: white; width: auto; padding: 0.6rem 1.2rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; border-radius: 8px; text-decoration: none;">
        <i class="fa-solid fa-file-import"></i> Import Transactions
    </a>
</div>

<!-- 4 Metrics Cards Grid -->
<div class="dashboard-grid" style="margin-bottom: 2rem;">
    <!-- Metric 1: Total Income -->
    <div class="stat-card">
        <div class="stat-details">
            <span class="stat-label">Total Income</span>
            <span class="stat-value" style="color: #064e3b;">@CurrencyHelper.Symbol(Context) @String.Format("{0:N2}", ViewBag.TotalIncome)</span>
        </div>
        <div class="stat-icon icon-blue">
            <i class="fa-solid fa-arrow-trend-up"></i>
        </div>
    </div>

    <!-- Metric 2: Total Expenses -->
    <div class="stat-card">
        <div class="stat-details">
            <span class="stat-label">Total Expenses</span>
            <span class="stat-value">@CurrencyHelper.Symbol(Context) @String.Format("{0:N2}", ViewBag.TotalExpense)</span>
        </div>
        <div class="stat-icon icon-red">
            <i class="fa-solid fa-chart-line"></i>
        </div>
    </div>

    <!-- Metric 3: Net Savings -->
    <div class="stat-card">
        <div class="stat-details">
            <span class="stat-label">Net Savings</span>
            <span class="badge" style="background-color: #0f766e; color: white; font-size: 1.25rem; font-weight: 700; border-radius: 6px; padding: 0.2rem 0.6rem; display: inline-block; margin-bottom: 0.25rem;">
                @CurrencyHelper.Symbol(Context) @String.Format("{0:N2}", ViewBag.NetSavings)
            </span>
            <span class="stat-trend up" style="color: var(--text-secondary);"><i class="fa-solid fa-piggy-bank"></i> Savings rate: @ViewBag.SavingsRate%</span>
        </div>
        <div class="stat-icon icon-green" style="background-color: var(--primary-bg); color: var(--primary);">
            <i class="fa-solid fa-vault"></i>
        </div>
    </div>

    <!-- Metric 4: Top Category -->
    <div class="stat-card">
        <div class="stat-details">
            <span class="stat-label">Top Category</span>
            <span class="stat-value" style="font-size: 1.4rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fa-solid fa-cart-shopping" style="color: #1e293b; font-size: 1.25rem;"></i> @ViewBag.TopCategory
            </span>
            <span class="stat-trend" style="color: var(--text-secondary);"><i class="fa-solid fa-pie-chart"></i> @ViewBag.TopCategoryPct% of total spend</span>
        </div>
        <div class="stat-icon icon-yellow">
            <i class="fa-solid fa-tags"></i>
        </div>
    </div>
</div>

<!-- Charts Section Grid -->
<div class="charts-section-grid">
    <!-- Chart: Income vs Expenses -->
    <div class="content-card">
        <div class="card-header-flex">
            <h3 class="card-title">Income vs Expenses (Monthly)</h3>
            <div style="display: flex; gap: 1rem; font-size: 0.75rem; font-weight: 600;">
                <span style="color: #0bb5a2;"><i class="fa-solid fa-circle"></i> Income</span>
                <span style="color: #1e293b;"><i class="fa-solid fa-circle"></i> Expenses</span>
            </div>
        </div>
        <div style="height: 250px; position: relative;">
            <canvas id="incomeExpensesWeeklyChart"></canvas>
        </div>
    </div>

    <!-- Insights List -->
    <div class="content-card">
        <div class="card-header-flex">
            <h3 class="card-title">Insights</h3>
        </div>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            @foreach (var insight in (ViewBag.Insights as List<PFMA.Helpers.ReportInsight> ?? new List<PFMA.Helpers.ReportInsight>()))
            {
                string bg = insight.Kind == "good" ? "#f0fdf4" : (insight.Kind == "warn" ? "var(--danger-bg)" : "#eff6ff");
                string border = insight.Kind == "good" ? "#bbf7d0" : (insight.Kind == "warn" ? "#fecaca" : "#bfdbfe");
                string color = insight.Kind == "good" ? "#166534" : (insight.Kind == "warn" ? "#991b1b" : "#1e40af");
                string icon = insight.Kind == "good" ? "fa-regular fa-circle-check" : (insight.Kind == "warn" ? "fa-solid fa-triangle-exclamation" : "fa-solid fa-circle-info");
                <div class="alert-banner" style="background-color: @bg; border-color: @border; color: @color; margin-bottom: 0;">
                    <i class="@icon" style="font-size: 1.1rem;"></i>
                    <div style="font-size: 0.8rem;">@insight.Text</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Goal Reached Image Card at bottom -->
<div class="content-card" style="margin-bottom: 2rem; background: linear-gradient(rgba(30,41,59,0.7), rgba(30,41,59,0.7)), url('https://images.unsplash.com/photo-1543269865-cbf427effbad?auto=format&fit=crop&w=800&q=80'); background-size: cover; background-position: center; border: none; height: 180px; display: flex; align-items: flex-end; padding: 1.5rem; border-radius: 16px;">
    <div style="color: white;">
        <h3 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 0.25rem;">Goal Reached!</h3>
        <p style="font-size: 0.85rem; color: #cbd5e1;">You have saved @CurrencyHelper.Symbol(Context) @String.Format("{0:N2}", ViewBag.TotalSaved) across all your savings goals. Keep up the great work!</p>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const canvas = document.getElementById("incomeExpensesWeeklyChart");
            if (!canvas || typeof Chart === "undefined") return;

            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.ChartLabels as string[]) ?? new string[0]));
            const income = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.ChartIncome as double[]) ?? new double[0]));
            const expense = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.ChartExpense as double[]) ?? new double[0]));

            new Chart(canvas.getContext("2d"), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Income', data: income, backgroundColor: '#0bb5a2', borderRadius: 4, barThickness: 14 },
                        { label: 'Expenses', data: expense, backgroundColor: '#1e293b', borderRadius: 4, barThickness: 14 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { grid: { color: '#f1f3f7' }, ticks: { color: '#94a3b8', font: { size: 9 } } },
                        x: { grid: { display: false }, ticks: { color: '#94a3b8', font: { size: 9 } } }
                    }
                }
            });
        });
    </script>
}
